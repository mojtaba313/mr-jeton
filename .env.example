# ---------------------------------------------------------------------------
# Local development environment. Gitignored — never commit the real values.
# Prisma 7 does NOT read .env on its own; prisma.config.ts loads it via dotenv.
# Next.js loads it for `next dev` / `next build`.
# ---------------------------------------------------------------------------

# PostgreSQL. Local role + database created for this app.
DATABASE_URL="postgresql://mrjeton:CHANGE_ME@127.0.0.1:5432/mrjeton?schema=public"

# Signs the session cookie (HS256, 7 days). Rotating it logs everyone out.
JWT_SECRET_KEY=""

# Absolute origin, used for metadataBase so OG/canonical URLs resolve.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Card-to-card collection details shown to buyers on the payment step, and to
# sellers on the payout step. Iranian cards: 16 digits, optionally +98 or 0098.
# ---------------------------------------------------------------------------
PAYMENT_CARD_NUMBER="6037-9918-1234-5678"
PAYMENT_CARD_HOLDER="شرکت پشتیبانی دانشگاه"

# Kept as a setting rather than hardcoded so it can change without a deploy.
# This is the whole business model: it is the only revenue line.
PLATFORM_FEE_PERCENT="5"

# ---------------------------------------------------------------------------
# Image storage — GitHub Contents API.
#
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Give the token the least
# privilege that works: fine-grained, limited to the bucket repository,
# "Contents: read and write".
#
# Leave GITHUB_TOKEN empty in development and uploads fall back to
# public/uploads/ on disk. Set it to move storage to GitHub.
# ---------------------------------------------------------------------------
GITHUB_BUCKET_OWNER="mojtaba313"
GITHUB_BUCKET_REPO="bucket"
GITHUB_BUCKET_BRANCH="main"
# Folder inside the bucket repository that holds this app's images.
GITHUB_BUCKET_DIR="mr-jeton"
GITHUB_TOKEN=""

# ---------------------------------------------------------------------------
# Phone verification through a Telegram bot.
#
# SERVER-ONLY. The site creates a one-time claim and hands the user a
# t.me/<bot>?start=<claim> link; the bot receives the phone number from Telegram
# itself (never from the user), compares it to the claim, and writes the verdict.
#
# Leave both empty and the registration page will say so explicitly instead of
# waiting forever. For local development without a bot, turn on the bypass below
# — registration then verifies itself.
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Development only. "true" skips Telegram entirely: do NOT set this on a real
# deployment, or anyone can register with any number.
TELEGRAM_VERIFICATION_BYPASS="false"

# Webhook secret: Telegram sends it in X-Telegram-Bot-Api-Secret-Token and our
# route rejects anything else. Generate once (`openssl rand -hex 16`) and reuse
# the same value in Vercel. Empty disables webhook delivery.
TELEGRAM_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Map. The lat/lng are only the frame the seller clicks inside; every listing
# stores its own drop point. Point the tile URL at an internal campus server if
# OpenStreetMap is slow or blocked on your network.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAP_LABEL="دانشگاه"
NEXT_PUBLIC_MAP_LAT="35.7000"
NEXT_PUBLIC_MAP_LNG="51.3900"
NEXT_PUBLIC_MAP_ZOOM="17"
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap"
